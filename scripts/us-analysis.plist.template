<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>KMP_INIT_AT_FORK</key>
		<string>FALSE</string>
		<key>MKL_NUM_THREADS</key>
		<string>1</string>
		<key>NUMEXPR_NUM_THREADS</key>
		<string>1</string>
		<key>OBJC_DISABLE_INITIALIZE_FORK_SAFETY</key>
		<string>YES</string>
		<key>OMP_NUM_THREADS</key>
		<string>1</string>
		<key>OPENBLAS_NUM_THREADS</key>
		<string>1</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>PREDICTION_ENGINE_NO_PROCESS_POOL</key>
		<string>1</string>
		<key>SKIP_ML_PREDICTION</key>
		<string>1</string>
		<key>SKIP_SENTIMENT</key>
		<string>1</string>
		<key>TOKENIZERS_PARALLELISM</key>
		<string>false</string>
		<key>VECLIB_MAXIMUM_THREADS</key>
		<string>1</string>
	</dict>
	<key>KeepAlive</key>
	<false/>
	<key>Label</key>
	<string>ai.stock-analyzer.us-analysis</string>
	<key>ProgramArguments</key>
	<array>
		<string>__PROJECT_ROOT__/.venv/bin/python</string>
		<string>main.py</string>
		<string>auto-analyze</string>
		<string>us</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>__PROJECT_ROOT__/logs/us-analysis.err.log</string>
	<key>StandardOutPath</key>
	<string>__PROJECT_ROOT__/logs/us-analysis.out.log</string>
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Hour</key>
			<integer>23</integer>
			<key>Minute</key>
			<integer>30</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>6</integer>
			<key>Minute</key>
			<integer>0</integer>
		</dict>
	</array>
	<key>WorkingDirectory</key>
	<string>__PROJECT_ROOT__</string>
</dict>
</plist>
