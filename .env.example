# 필수: 세션 암호화 키 (변경 필수)
SECRET_KEY=your-secret-key-change-this

# 웹 서버 포트 (기본: 8080)
PORT=8080

# 로그 레벨: debug | info | warning | error (기본: info)
LOG_LEVEL=info

# 인증 (인터넷 노출 — 예: Tailscale Funnel — 시 활성화)
# ENABLE_BASIC_AUTH=1 + 사용자 자격증명 필수. 0 또는 미설정 시 인증 우회.
ENABLE_BASIC_AUTH=0

# 다중 사용자 — 세미콜론(;) 로 구분, 각 항목은 user:password
# 예: BASIC_AUTH_USERS=admin:s3cret;sykim:pw2;guest:pw3
BASIC_AUTH_USERS=

# 단일 사용자 (호환성 유지) — BASIC_AUTH_USERS 가 비어있을 때만 사용됨
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=

# macOS gunicorn 환경에서 ML ProcessPool 이 fork+native lib 충돌로 segfault
# 일으키는 경우 1 로 설정하면 순차 실행 fallback 사용 (느리지만 안정).
# 기본 0: ProcessPool 시도 + 실패 시 fallback.
PREDICTION_ENGINE_NO_PROCESS_POOL=0

# Leader Stock Finder (주도주 발굴 페이지)
# Gemini 2.5 Flash API 키 (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# 일일 LLM 호출 cap (universe 50종 기준 5종 통과 가정 × 4배 여유)
LEADER_LLM_DAILY_LIMIT=20
# auto-trader universe.yaml 경로 (read-only 참조)
AUTO_TRADER_UNIVERSE_PATH=../auto-trader/config/universe.yaml
