# 필수: 세션 암호화 키 (변경 필수)
SECRET_KEY=your-secret-key-change-this

# 웹 서버 포트 (기본: 8080)
PORT=8080

# 로그 레벨: debug | info | warning | error (기본: info)
LOG_LEVEL=info

# 인증 (인터넷 노출 — 예: Tailscale Funnel — 시 활성화)
# ENABLE_BASIC_AUTH=1 + USERNAME/PASSWORD 모두 설정해야 함. 0 또는 미설정 시 인증 우회.
ENABLE_BASIC_AUTH=0
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=
